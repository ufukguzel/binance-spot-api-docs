# Kopyala: cp env.example .env  sonra değerleri doldur.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BASE_URL=https://demo-fapi.binance.com

# Panel API (webhook_server.py)
DASHBOARD_TOKEN=
PANEL_PORT=8080

# Sinyal botu: python futures_signal_runner.py
SIGNAL_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
KLINE_INTERVAL=1m
SHORT_WINDOW=7
LONG_WINDOW=25
LOOP_SECONDS=20

DRY_RUN=true
ALLOW_LIVE_ORDERS=false
SYMBOL=BTCUSDT
FUTURES_QTY=0.002
SYMBOL_QTY_MAP={"BTCUSDT":0.002}

PRODUCT_NAME=SignalRail
