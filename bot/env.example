# Kopyala: cp env.example .env  sonra değerleri doldur.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BASE_URL=https://demo-fapi.binance.com
WEBHOOK_SECRET=
WEBHOOK_PORT=8080
DRY_RUN=true
ALLOW_LIVE_ORDERS=false
SYMBOL=BTCUSDT
FUTURES_QTY=0.002
SYMBOL_QTY_MAP={"BTCUSDT":0.002}

# Kontrol paneli (boşsa /dashboard kapalı)
DASHBOARD_TOKEN=
# İsteğe bağlı: "Stratejiyi TradingView'de aç" butonu için tam URL
TRADINGVIEW_STRATEGY_URL=
