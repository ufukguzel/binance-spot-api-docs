BINANCE_API_KEY=your_demo_futures_key
BINANCE_API_SECRET=your_demo_futures_secret
# Demo Futures: https://demo.binance.com > API Management
BASE_URL=https://demo-fapi.binance.com
SYMBOL=BTCUSDT
KLINE_INTERVAL=1m
SHORT_WINDOW=7
LONG_WINDOW=25
FUTURES_QTY=0.002
# Opsiyonel: coin bazli varsayilan qty (JSON)
# SYMBOL_QTY_MAP={"BTCUSDT":0.002,"ETHUSDT":0.01,"BNBUSDT":0.05}
MAX_DAILY_LOSS_PCT=2
LOOP_SECONDS=20
DRY_RUN=true
ALLOW_LIVE_ORDERS=false
WEBHOOK_SECRET=change_me
WEBHOOK_PORT=8080
